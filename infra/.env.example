# Config global da instalação (compartilhada por todos os clientes) - gerada
# automaticamente na 1ª execução de install-client.sh a partir deste arquivo.
# NUNCA comitar o infra/.env real (já está no .gitignore) - só este .example.

# Cloudflare (Zone:DNS:Edit no token) - usado pra criar o registro A de cada
# subdomínio novo automaticamente. Deixe em branco que o script pergunta na
# primeira instalação e salva aqui pras próximas.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# IP público deste servidor - detectado automaticamente na 1ª instalação
# (ifconfig.me) se deixar em branco.
SERVER_PUBLIC_IP=

# Rede Docker onde o Traefik que JÁ ESTÁ rodando escuta, e o certResolver
# configurado nele - ajuste esses dois se o seu Traefik usar nomes diferentes.
TRAEFIK_NETWORK=traefik-public
TRAEFIK_CERT_RESOLVER=cloudflare
TRAEFIK_ENTRYPOINT=websecure
