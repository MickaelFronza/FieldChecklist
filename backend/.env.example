NODE_ENV=development
PORT=3000
# aceita uma lista separada por virgula (ex.: dev local + container do
# frontend rodando ao mesmo tempo)
CORS_ORIGIN=http://localhost:5173,http://localhost:8080

# JWT
# NUNCA use os valores abaixo literalmente - sao so pra mostrar o formato.
# Gere um segredo de verdade com: openssl rand -base64 48 (ou similar)
# Qualquer um que souber esse valor consegue forjar um token valido.
JWT_SECRET=GERE_UM_VALOR_ALEATORIO_FORTE_AQUI
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=GERE_OUTRO_VALOR_ALEATORIO_DIFERENTE_AQUI
JWT_REFRESH_EXPIRES_IN=30d
# refresh token de Admin/Gestor (painel web) - operador (PIN) usa o de cima
JWT_REFRESH_EXPIRES_IN_WEB=90d

# Bootstrap do Admin (conta especial, fora do CRUD de usuarios)
ADMIN_EMAIL=admin@fieldcheck.local
ADMIN_PASSWORD=DEFINA_UMA_SENHA_FORTE_AQUI

# Bcrypt
BCRYPT_SALT_ROUNDS=10

# MariaDB
DB_HOST=mariadb
DB_PORT=3306
DB_NAME=field_checklist
DB_USER=field_checklist
DB_PASSWORD=field_checklist
DB_ROOT_PASSWORD=root

# Redis / Bull
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# MinIO / S3
# console web (porta 9001) nao fica mais exposta pra internet - o backend
# acessa via rede interna do compose e faz proxy em /admin/minio-console
MINIO_CONSOLE_URL=http://minio:9001
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=field-checklist-photos
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Regras de negocio
LATE_CHECKLIST_ALERT_TIME=08:30
